{
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "target": "es2020",
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2017",
      "dom"
    ],
    "esModuleInterop": true,
    "types": [
      "node",
      "jest"
    ],
    "rootDir": "modules",
    "strict": false
  },
  "include": [
    "modules/**/*.ts"
  ]
}
